  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Importações Corretas e Seguras\r\nimport clr\r\nclr.AddReference(\"ProtoGeometry\")\r\nimport Autodesk.DesignScript.Geometry as DS # Apelido para Geometria do Dynamo\r\n\r\nclr.AddReference('RevitAPI')\r\nimport Autodesk.Revit.DB as DB # Apelido para API do Revit\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nimport locale\r\n\r\n# --- PASSO 0: CONFIGURAÇÃO ---\r\ntry:\r\n    locale.setlocale(locale.LC_NUMERIC, 'C')\r\nexcept:\r\n    pass\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nfilepath = IN[0]\r\n\r\n# --- PASSO 1: PRÉ-PROCESSAMENTO E LIMPEZA DOS DADOS (SUA LÓGICA) ---\r\n# Esta é a etapa mais importante, baseada na sua análise.\r\ncleaned_lines = []\r\nraw_lines = []\r\nerror_message = None\r\n\r\ntry:\r\n    with open(filepath, 'r', encoding='utf-8-sig') as f:\r\n        raw_lines = f.readlines()\r\n    \r\n    # Itera sobre o arquivo, pegando 3 linhas e pulando a 4ª\r\n    for i in range(0, len(raw_lines), 4):\r\n        # Garante que temos um grupo completo de 3 para adicionar\r\n        if i + 2 < len(raw_lines):\r\n            cleaned_lines.append(raw_lines[i])\r\n            cleaned_lines.append(raw_lines[i+1])\r\n            cleaned_lines.append(raw_lines[i+2])\r\n\r\n    # --- PASSO 2: LEITURA DOS PONTOS A PARTIR DOS DADOS LIMPOS ---\r\n    points = []\r\n    for line in cleaned_lines:\r\n        line = line.strip()\r\n        if line:\r\n            parts = line.split(',')\r\n            if len(parts) == 3:\r\n                x = float(parts[0])\r\n                y = float(parts[1])\r\n                z = float(parts[2])\r\n                points.append(DS.Point.ByCoordinates(x, y, z))\r\nexcept Exception as e:\r\n    error_message = \"Erro ao ler ou processar o arquivo: \" + str(e)\r\n\r\n\r\n# --- PASSO 3: CONSTRUÇÃO FINAL E ENVIO PARA O REVIT ---\r\nif not error_message:\r\n    if points:\r\n        # Cria a lista de faces triangulares a partir dos pontos limpos\r\n        face_indices_groups = []\r\n        # Os pontos já estão limpos e ordenados. Basta criar os índices.\r\n        for i in range(0, len(points) // 3):\r\n            idx1 = i * 3\r\n            idx2 = i * 3 + 1\r\n            idx3 = i * 3 + 2\r\n            face_indices_groups.append(DS.IndexGroup.ByIndices(idx1, idx2, idx3))\r\n\r\n        if face_indices_groups:\r\n            try:\r\n                # Cria UMA ÚNICA MALHA a partir de todos os pontos e faces\r\n                final_mesh = DS.Mesh.ByPointsFaceIndices(points, face_indices_groups)\r\n                \r\n                if final_mesh:\r\n                    # Converte a malha para o formato do Revit\r\n                    revit_geoms = final_mesh.ToRevitType()\r\n                    \r\n                    TransactionManager.Instance.EnsureInTransaction(doc)\r\n                    \r\n                    # Usa DirectShape, a ferramenta correta para esta geometria\r\n                    catId = DB.ElementId(DB.BuiltInCategory.OST_GenericModel)\r\n                    ds = DB.DirectShape.CreateElement(doc, catId)\r\n                    ds.SetShape(revit_geoms)\r\n                    \r\n                    TransactionManager.Instance.TransactionTaskDone()\r\n                    \r\n                    OUT = \"SUCESSO. Geometria criada usando sua lógica de limpeza de dados.\"\r\n                else:\r\n                    OUT = \"Falha. A malha final não pôde ser criada com os dados limpos.\"\r\n            except Exception as e:\r\n                OUT = \"Erro final ao criar a malha ou enviá-la para o Revit: \" + str(e)\r\n        else:\r\n            OUT = \"FALHA: Nenhuma face válida pôde ser criada a partir dos dados limpos.\"\r\n    else:\r\n        OUT = \"FALHA FINAL: Nenhum ponto foi processado após a limpeza do arquivo.\"\r\nelse:\r\n    OUT = error_message",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "90b937dd14a740afa0a8d9819fb78cf1",
      "NodeType": "PythonScriptNode",
