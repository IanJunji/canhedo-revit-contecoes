    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 4: Encontrar Arestas do Perímetro (Arestas Nuas)\r\nimport clr\r\n\r\n# Pega a lista de IndexGroup da entrada\r\nindex_groups = IN[0]\r\n\r\n# Um dicionário para contar quantas vezes cada aresta aparece\r\nedge_counts = {}\r\n\r\n# Itera por cada face (triângulo) da nossa malha\r\nfor group in index_groups:\r\n    indices = [group.A, group.B, group.C]\r\n    \r\n    # Gera as 3 arestas de cada triângulo\r\n    # Usamos min/max para normalizar a aresta (ex: a aresta 5-10 é a mesma que 10-5)\r\n    edges = [\r\n        tuple(sorted((indices[0], indices[1]))),\r\n        tuple(sorted((indices[1], indices[2]))),\r\n        tuple(sorted((indices[2], indices[0])))\r\n    ]\r\n    \r\n    # Conta cada aresta\r\n    for edge in edges:\r\n        edge_counts[edge] = edge_counts.get(edge, 0) + 1\r\n\r\n# Filtra o dicionário para encontrar as arestas que só apareceram 1 vez\r\n# Essas são as arestas do perímetro (as arestas \"nuas\")\r\nnaked_edges = [edge for edge, count in edge_counts.items() if count == 1]\r\n\r\n# A saída é uma lista de pares de índices (ex: [[5,10], [10, 18], ...])\r\nOUT = naked_edges",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a74fee5e45594b9a84925f56775fbd05",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "c759c30fedfd480bb02b17d95e0d9fd8",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
