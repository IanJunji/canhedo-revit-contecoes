    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 01: Encontrar Vértices Únicos\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Point\r\nimport sys\r\n\r\n# Pega o caminho do arquivo da primeira entrada\r\nfilepath = IN[0]\r\nfile_content = \"\"\r\n\r\n# Tenta ler o conteúdo do arquivo de texto\r\ntry:\r\n    with open(filepath, 'r') as f:\r\n        file_content = f.read()\r\nexcept Exception as e:\r\n    OUT = \"ERRO AO LER O ARQUIVO: \" + str(e)\r\n    sys.exit()\r\n\r\n# Separa o conteúdo em linhas\r\nlines = file_content.strip().split('\\n')\r\n\r\n# Listas para armazenar os pontos únicos e um mapa para evitar duplicatas\r\nunique_points = []\r\npoint_map = {} # Dicionário para rastrear pontos já adicionados\r\n\r\n# Itera por todas as linhas do arquivo\r\nfor line in lines:\r\n    if line.strip():\r\n        # A coordenada em texto (ex: \"1.0,2.0,3.0\") é a chave de verificação\r\n        line_key = line.strip()\r\n        \r\n        # Se este ponto ainda não foi visto...\r\n        if line_key not in point_map:\r\n            try:\r\n                # ...cria o ponto, adiciona na lista e registra no mapa\r\n                coords = line.split(',')\r\n                pt = Point.ByCoordinates(float(coords[0]), float(coords[1]), float(coords[2]))\r\n                point_map[line_key] = len(unique_points) # Registra o índice do novo ponto\r\n                unique_points.append(pt)\r\n            except:\r\n                # Ignora linhas mal formatadas\r\n                pass\r\n\r\n# A única saída deste script é a lista de pontos únicos\r\nOUT = unique_points",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "cac6907b08e348fca85b5c593c72f0cb",
      "NodeType": "PythonScriptNode",
