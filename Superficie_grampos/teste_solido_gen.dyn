          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 5 (VERSÃO FINAL): Construir Sólido com Offset por Normais\r\nimport clr\r\n\r\n# Importações necessárias da API do Revit e do Dynamo\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import TessellatedShapeBuilder, TessellatedShapeBuilderTarget, TessellatedShapeBuilderFallback, TessellatedFace, XYZ, DirectShape, ElementId, BuiltInCategory, TessellatedShapeBuilderOutcome\r\nfrom System.Collections.Generic import List\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# --- Pegar os Dados das Entradas ---\r\ndynamo_points = IN[0]\r\nindex_groups = IN[1]\r\nnaked_edges_indices = IN[2]\r\nthickness = IN[3]\r\nvertex_normals_dynamo = IN[4] # <<<<<< NOVA ENTRADA\r\n\r\n# --- Preparação dos Dados ---\r\n# Converte os pontos do Dynamo para o formato XYZ do Revit\r\ntop_points_rvt = [XYZ(pt.X, pt.Y, pt.Z) for pt in dynamo_points]\r\n# Converte os vetores normais do Dynamo para o formato XYZ do Revit\r\nvertex_normals_rvt = [XYZ(v.X, v.Y, v.Z) for v in vertex_normals_dynamo]\r\n\r\n# >>>>>> ESTA É A MUDANÇA PRINCIPAL <<<<<<\r\n# Cria os pontos da base movendo cada ponto do topo ao longo de sua normal\r\nbottom_points_rvt = []\r\nfor i in range(len(top_points_rvt)):\r\n    top_point = top_points_rvt[i]\r\n    normal_vector = vertex_normals_rvt[i]\r\n    # Multiplica o vetor normal (de comprimento 1) pela espessura desejada\r\n    offset_vector = normal_vector.Multiply(thickness)\r\n    # Subtrai o vetor de offset do ponto do topo para encontrar o ponto da base\r\n    bottom_point = top_point.Subtract(offset_vector)\r\n    bottom_points_rvt.append(bottom_point)\r\n\r\n# Pega o documento atual do Revit\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# --- O RESTO DO CÓDIGO É IDÊNTICO ---\r\n\r\n# Garante que estamos dentro de uma transação do Revit\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\nbuilder = TessellatedShapeBuilder()\r\nbuilder.OpenConnectedFaceSet(True)\r\n\r\n# 1. Adicionar as Faces do TOPO\r\nfor group in index_groups:\r\n    face_loop = List[XYZ](); face_loop.Add(top_points_rvt[group.A]); face_loop.Add(top_points_rvt[group.B]); face_loop.Add(top_points_rvt[group.C])\r\n    builder.AddFace(TessellatedFace(face_loop, ElementId.InvalidElementId))\r\n\r\n# 2. Adicionar as Faces da BASE\r\nfor group in index_groups:\r\n    face_loop = List[XYZ](); face_loop.Add(bottom_points_rvt[group.A]); face_loop.Add(bottom_points_rvt[group.C]); face_loop.Add(bottom_points_rvt[group.B])\r\n    builder.AddFace(TessellatedFace(face_loop, ElementId.InvalidElementId))\r\n    \r\n# 3. Adicionar as Faces LATERAIS\r\nfor edge in naked_edges_indices:\r\n    idx1, idx2 = edge[0], edge[1]\r\n    face_loop = List[XYZ](); face_loop.Add(top_points_rvt[idx1]); face_loop.Add(top_points_rvt[idx2]); face_loop.Add(bottom_points_rvt[idx2]); face_loop.Add(bottom_points_rvt[idx1])\r\n    builder.AddFace(TessellatedFace(face_loop, ElementId.InvalidElementId))\r\n\r\n# Finaliza a Construção\r\nbuilder.CloseConnectedFaceSet()\r\nbuilder.Target = TessellatedShapeBuilderTarget.Solid\r\nbuilder.Fallback = TessellatedShapeBuilderFallback.Abort\r\nbuilder.Build()\r\nresult = builder.GetBuildResult()\r\n\r\n# Criar o Elemento no Revit\r\nfinal_object = None\r\nif result.Outcome == TessellatedShapeBuilderOutcome.Solid:\r\n    geom_objects = result.GetGeometricalObjects()\r\n    ds = DirectShape.CreateElement(doc, ElementId(BuiltInCategory.OST_GenericModel))\r\n    ds.SetShape(geom_objects)\r\n    final_object = ds\r\nelse:\r\n    final_object = \"Falha ao criar o sólido: \" + str(result.Outcome)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\nOUT = final_object",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "006af1aa3c774483b86eab2d852b1d41",
      "NodeType": "PythonScriptNode",
      "Inputs": [
