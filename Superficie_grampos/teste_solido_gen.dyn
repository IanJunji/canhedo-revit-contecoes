    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 2: Montar Índices das Faces\r\nimport clr\r\nimport sys\r\nfrom Autodesk.DesignScript.Geometry import IndexGroup\r\n\r\nfilepath = IN[0]\r\nfile_content = \"\"\r\ntry:\r\n    with open(filepath, 'r') as f:\r\n        file_content = f.read()\r\nexcept Exception as e:\r\n    OUT = \"ERRO AO LER O ARQUIVO: \" + str(e)\r\n    sys.exit()\r\n\r\nlines = file_content.strip().split('\\n')\r\npoint_map = {}\r\ntemp_unique_points_count = 0\r\nfor line in lines:\r\n    if line.strip():\r\n        line_key = line.strip()\r\n        if line_key not in point_map:\r\n            point_map[line_key] = temp_unique_points_count\r\n            temp_unique_points_count += 1\r\n\r\nface_indices = []\r\nfor i in range(0, len(lines), 4):\r\n    face_lines = lines[i:i+3]\r\n    current_face_indices = []\r\n    if len(face_lines) == 3:\r\n        for line in face_lines:\r\n            if line.strip():\r\n                line_key = line.strip()\r\n                idx = point_map[line_key]\r\n                current_face_indices.append(idx)\r\n        if len(current_face_indices) == 3:\r\n            face_indices.append(IndexGroup.ByIndices(*current_face_indices))\r\nOUT = face_indices",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "2533b377152948cb8f3d8c304c300a18",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "86f7689a40014b1e876ba6d8582c0f57",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "1762e5fc3d97426cbbd2aef71ab543fb",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
