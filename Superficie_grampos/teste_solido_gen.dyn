    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 3: Reconstruir Superfícies Limpas\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Surface, PolyCurve\r\n\r\npoints = IN[0]\r\nindex_groups = IN[1]\r\nsurfaces = []\r\nfor group in index_groups:\r\n    idx1, idx2, idx3 = group.A, group.B, group.C\r\n    pt1, pt2, pt3 = points[idx1], points[idx2], points[idx3]\r\n    polycurve = PolyCurve.ByPoints([pt1, pt2, pt3], True)\r\n    surface = Surface.ByPatch(polycurve)\r\n    surfaces.append(surface)\r\nOUT = surfaces",
