    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 6: Calcular Normais dos Vértices (VERSÃO CORRIGIDA E ROBUSTA)\r\nimport clr\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import XYZ\r\n\r\n# Pega os dados das entradas\r\ndynamo_points = IN[0]\r\nindex_groups = IN[1]\r\n\r\n# Converte pontos do Dynamo para o formato XYZ do Revit\r\npoints_rvt = [XYZ(pt.X, pt.Y, pt.Z) for pt in dynamo_points]\r\n\r\n# 1. Calcular a normal de cada face (triângulo)\r\nface_normals = []\r\n# Define um vetor de referência \"para cima\"\r\nz_axis = XYZ.BasisZ\r\n\r\nfor group in index_groups:\r\n    p1 = points_rvt[group.A]\r\n    p2 = points_rvt[group.B]\r\n    p3 = points_rvt[group.C]\r\n    v1 = p2.Subtract(p1)\r\n    v2 = p3.Subtract(p1)\r\n    normal = v1.CrossProduct(v2).Normalize()\r\n    \r\n    # >>>>>> ESTA É A CORREÇÃO CRUCIAL <<<<<<\r\n    # Garante que a normal sempre aponte para cima (no eixo Z)\r\n    # Se o ângulo entre a normal e o eixo Z for maior que 90 graus, ela está de cabeça para baixo\r\n    if normal.DotProduct(z_axis) < 0:\r\n        normal = normal.Negate() # Inverte a normal\r\n        \r\n    face_normals.append(normal)\r\n    \r\n# 2. Calcular a normal de cada vértice (o resto do código é o mesmo)\r\nvertex_normals = [XYZ.Zero for _ in points_rvt]\r\nfor i, group in enumerate(index_groups):\r\n    vertex_normals[group.A] = vertex_normals[group.A].Add(face_normals[i])\r\n    vertex_normals[group.B] = vertex_normals[group.B].Add(face_normals[i])\r\n    vertex_normals[group.C] = vertex_normals[group.C].Add(face_normals[i])\r\n\r\n# 3. Finaliza normalizando cada um dos vetores de vértice resultantes\r\nfinal_vertex_normals = [v.Normalize() for v in vertex_normals]\r\n\r\n# A saída é uma lista de vetores normais consistentes\r\nOUT = final_vertex_normals",
