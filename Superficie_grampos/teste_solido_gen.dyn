      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 1: Encontrar Vértices Únicos\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Point\r\nimport sys\r\n\r\nfilepath = IN[0]\r\nfile_content = \"\"\r\ntry:\r\n    with open(filepath, 'r') as f:\r\n        file_content = f.read()\r\nexcept Exception as e:\r\n    OUT = \"ERRO AO LER O ARQUIVO: \" + str(e)\r\n    sys.exit()\r\n\r\nlines = file_content.strip().split('\\n')\r\nunique_points = []\r\npoint_map = {}\r\nfor line in lines:\r\n    if line.strip():\r\n        line_key = line.strip()\r\n        if line_key not in point_map:\r\n            try:\r\n                coords = line.split(',')\r\n                pt = Point.ByCoordinates(float(coords[0]), float(coords[1]), float(coords[2]))\r\n                point_map[line_key] = len(unique_points)\r\n                unique_points.append(pt)\r\n            except:\r\n                pass\r\nOUT = unique_points",
