    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# SCRIPT 02: Montar Índices das Faces (VERSÃO FINAL)\r\nimport clr\r\nimport sys\r\n\r\n# Importa o tipo de dado específico que o nó Mesh precisa\r\nfrom Autodesk.DesignScript.Geometry import IndexGroup\r\n\r\n# Pega o caminho do arquivo da primeira entrada\r\nfilepath = IN[0]\r\nfile_content = \"\"\r\n\r\n# Tenta ler o conteúdo do arquivo\r\ntry:\r\n    with open(filepath, 'r') as f:\r\n        file_content = f.read()\r\nexcept Exception as e:\r\n    OUT = \"ERRO AO LER O ARQUIVO: \" + str(e)\r\n    sys.exit()\r\n\r\n# Recria o mapa de pontos para encontrar os índices\r\nlines = file_content.strip().split('\\n')\r\npoint_map = {}\r\ntemp_unique_points_count = 0\r\nfor line in lines:\r\n    if line.strip():\r\n        line_key = line.strip()\r\n        if line_key not in point_map:\r\n            point_map[line_key] = temp_unique_points_count\r\n            temp_unique_points_count += 1\r\n\r\n# Monta os índices das faces\r\nface_indices = []\r\nfor i in range(0, len(lines), 4):\r\n    face_lines = lines[i:i+3]\r\n    current_face_indices = []\r\n    \r\n    if len(face_lines) == 3:\r\n        for line in face_lines:\r\n            if line.strip():\r\n                line_key = line.strip()\r\n                idx = point_map[line_key]\r\n                current_face_indices.append(idx)\r\n        \r\n        if len(current_face_indices) == 3:\r\n            # --- CORREÇÃO FINAL ---\r\n            # O asterisco (*) desempacota a lista em argumentos individuais\r\n            face_indices.append(IndexGroup.ByIndices(*current_face_indices))\r\n\r\n# A saída agora é uma lista de objetos IndexGroup, o tipo de dado correto.\r\nOUT = face_indices",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "3431cf3064c54801b0d1b02c83de3b46",
      "NodeType": "PythonScriptNode",
