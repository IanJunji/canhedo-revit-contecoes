          "Name": "sheetName",
          "Description": "Nome da planilha que contém os dados\n\nstring",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b5810ed31ba0418383ad8720b2449d9a",
          "Name": "readAsStrings",
          "Description": "Alternar para ler células como sequências de caracteres\n\nbool\nValor padrão : false",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f68923392e9c4a42bc7a07892aaf9221",
          "Name": "showExcel",
          "Description": "Alternar para exibir a janela principal do Excel\n\nbool\nValor padrão : true",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
